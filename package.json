{
  "name": "nuxtlify",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Sylvester Carolan — solutions engineer and architect. Built a production auditable-LLM civic platform; 20+ years in regulated data infrastructure (Go, Python, PostgreSQL, Kubernetes).",
  "author": "Daniel Kelly",
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "precommit": "npm run lint",
    "before-build": "node ./build-tools/beforeBuild.js",
    "after-build": "node ./build-tools/afterBuild.js",
    "dev": "npm run before-build && nuxt dev -o",
    "build": "npm run before-build && nuxt build && npm run after-build",
    "start": "nuxt preview",
    "generate": "npm run before-build && nuxt generate && npm run after-build",
    "cms-proxy": "netlify-cms-proxy-server"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.19",
    "@fortawesome/free-solid-svg-icons": "^5.9.0",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@nuxt/image": "^1.8.1",
    "@pinia/nuxt": "^0.5.5",
    "animate.css": "^3.7.2",
    "gray-matter": "^4.0.2",
    "intersection-observer": "^0.7.0",
    "lodash.chunk": "^4.2.0",
    "lodash.isstring": "^4.0.1",
    "lodash.range": "^3.2.0",
    "markdown-it": "^8.4.2",
    "markdown-it-deflist": "^2.0.3",
    "markdown-it-footnote": "^3.0.1",
    "markdown-it-sub": "^1.0.0",
    "markdown-it-sup": "^1.0.0",
    "mitt": "^3.0.1",
    "ncp": "^2.0.0",
    "nuxt": "^3.14.1592",
    "nuxt-gtag": "^3.0.2",
    "pinia": "^2.2.6",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "@nuxt/eslint": "^0.6.1",
    "buefy": "^0.8.20",
    "bulma": "^0.7.5",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "netlify-cms-proxy-server": "^1.3.24",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "rimraf": "^2.6.3",
    "sass": "^1.80.6"
  }
}
